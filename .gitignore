# Configuracio local de Claude Code (permisos, ajustos de maquina)
.claude/

# Cache de Python (generador del web)
__pycache__/
*.pyc

# Entorn virtual de Python
.venv/

# Web GENERAT: es reconstrueix a CI (web/_generador/generar.py) a cada push.
# Es versionen només els FONTS: estil.css, lloc.js, el generador i web/README.md.
/web/*.html
/web/.nojekyll
/web/classes/
/web/programacio/
/web/avaluacio/
/web/normativa/
/web/reptes/
/web/recursos/
/web/simulacions/
/web/pdf/
/web/assets/img/
/web/assets/css/pygments.css
/web/assets/js/cerca-index.js
/web/_generador/_activitats.json

# Fitxers temporals del sistema
Thumbs.db
desktop.ini
~$*
*.tmp

# Fitxers temporals d'Office en obrir documents
.~lock.*

# Material massa gros per a GitHub (>100 MB). El contingut ja es guarda
# descomprimit a la carpeta "Fitxes STEAM Cards curs 2020-2021/".
Recursos/Fitxes STEAM Cards curs 2020-2021-*.zip
